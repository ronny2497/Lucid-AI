{
  "name": "@lucid/explorer",
  "version": "0.0.0",
  "description": "@lucid/explorer — the read-only Lucid trace explorer SPA (Vite + React 18 + Recharts). Renders the run list, single-trace view (turns -> events with principle/quadrant badges + a Recharts timeline), and the server-derived base-metrics panel from the collector /api/* routes (REQ-02).",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@lucid/hsc-schema": "workspace:*",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-router": "^1.58.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^25.0.0",
    "typescript": "5.3.3",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
