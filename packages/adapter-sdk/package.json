{
  "name": "@lucid/adapter-sdk",
  "version": "0.0.0",
  "description": "@lucid/adapter-sdk — the declarative adapter authoring contract for HSC v0 (REQ-07). Wraps @lucid/sdk with the AdapterManifest schema (`targets HSC vX`); defineAdapter()/emit-or-omit helpers land in 06-03.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ./scripts/copy-templates.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@lucid/hsc-schema": "workspace:*",
    "@lucid/sdk": "workspace:*",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "~1.9.0",
    "@opentelemetry/sdk-trace-node": "^2.8.0",
    "typescript": "5.3.3",
    "vitest": "^2.1.9"
  }
}
